#!/usr/bin/env bash
# Quiet status board for Claude Code sessions running in tmux.
#
#   claude-tasks              open the picker (meant for: tmux display-popup -E)
#   claude-tasks hook EVENT   record a hook event (Claude Code hook JSON on stdin)
#   claude-tasks list         print sessions (used by the picker)
#   claude-tasks clear PANE   remove a session from the list until its next hook event
#   claude-tasks jump PANE    switch the current tmux client to that pane
#
# State: one file per tmux pane in $CLAUDE_TASKS_DIR (default
# $XDG_STATE_HOME/claude-tasks), holding "status<TAB>epoch<TAB>cwd<TAB>session id<TAB>process",
# where process is "pid start-time" of the process hosting the session. Files for panes that no
# longer exist are pruned; entries whose process is gone are hidden.

state="${CLAUDE_TASKS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-tasks}"
mkdir -p "$state"
self="$(realpath "$0")"

started() { # pid...: one "pid start-time" line each, for pids that exist
    # C locale and squeezed spaces, so the hook and list produce identical strings.
    LC_ALL=C ps -o pid=,lstart= -p "$(IFS=,; echo "$*")" 2>/dev/null | tr -s ' ' | sed 's/^ //'
}

# The process just below the pane's shell that this hook descends from: Claude itself, or a
# wrapper script that started it. Its name is no use (a non-exec wrapper makes tmux report the
# pane as running "fish"), but while it exists, the session is open. Empty if not under the pane.
host_process() { # pane
    local root pid=$$ parent
    root="$(tmux display -p -t "$1" '#{pane_pid}' 2>/dev/null)"
    [[ -n "$root" ]] || return 0
    while ((pid > 1)); do
        parent="$(ps -o ppid= -p "$pid" 2>/dev/null)"
        parent="${parent//[[:space:]]/}"
        [[ -n "$parent" ]] || return 0
        if [[ "$parent" == "$root" ]]; then
            started "$pid"
            return 0
        fi
        pid="$parent"
    done
}

set_status() { # pane status [cwd] [session-id] [new-process]
    local file="$state/${1#%}" cwd="$3" sid="$4" proc=""
    [[ -z "$cwd" && -f "$file" ]] && cwd="$(cut -f3 "$file")"
    [[ -z "$sid" && -f "$file" ]] && sid="$(cut -f4 "$file")"
    # SessionStart may come from a new Claude process; otherwise keep the recorded one.
    [[ -z "$5" && -f "$file" ]] && proc="$(cut -f5 "$file")"
    [[ -z "$proc" ]] && proc="$(host_process "$1")"
    printf '%s\t%s\t%s\t%s\t%s\n' "$2" "$(date +%s)" "$cwd" "$sid" "$proc" >"$file"
}

hook() {
    [[ -z "$TMUX_PANE" ]] && exit 0
    local input cwd sid file="$state/${TMUX_PANE#%}"
    input="$(cat)"
    # \x1f, not tab: read collapses runs of whitespace IFS characters, losing empty fields.
    IFS=$'\x1f' read -r cwd sid < <(jq -r '"\(.cwd // "")\u001f\(.session_id // "")"' <<<"$input" 2>/dev/null)
    case "$1" in
        SessionStart) set_status "$TMUX_PANE" idle "$cwd" "$sid" new ;;
        UserPromptSubmit) set_status "$TMUX_PANE" running "$cwd" "$sid" ;;
        Stop) set_status "$TMUX_PANE" done "$cwd" "$sid" ;;
        SessionEnd) rm -f "$file" ;;
        Notification)
            # Only real "needs you" prompts; ignore the idle reminder after a reply.
            case "$(jq -r '.notification_type // empty' <<<"$input")" in
                permission_prompt | elicitation_dialog) set_status "$TMUX_PANE" waiting "$cwd" "$sid" ;;
            esac
            ;;
        PostToolUse)
            # A tool ran, so a pending permission prompt was answered.
            [[ "$(cut -f1 "$file" 2>/dev/null)" == waiting ]] && set_status "$TMUX_PANE" running "$cwd" "$sid"
            ;;
    esac
    exit 0
}

ago() {
    local s=$(($(date +%s) - $1))
    if ((s < 60)); then echo "${s}s"
    elif ((s < 3600)); then echo "$((s / 60))m"
    elif ((s < 86400)); then echo "$((s / 3600))h"
    else echo "$((s / 86400))d"
    fi
}

list() {
    local panes file line id status epoch cwd proc target title rank icon color pids
    local -A alive=()
    panes="$(tmux list-panes -a -F '#{pane_id}')"
    pids=($(cut -sf5 -- "$state"/* 2>/dev/null | cut -d' ' -f1 | grep -xE '[0-9]+'))
    if ((${#pids[@]})); then
        while IFS= read -r line; do alive[$line]=1; done < <(started "${pids[@]}")
    fi
    for file in "$state"/*; do
        [[ -f "$file" ]] || continue
        id="%${file##*/}"
        if ! grep -qx -- "$id" <<<"$panes"; then
            rm -f "$file"
            continue
        fi
        IFS= read -r line <"$file"
        IFS=$'\x1f' read -r status epoch cwd _ proc <<<"${line//$'\t'/$'\x1f'}"
        # The process hosting this session is gone: Claude was killed, so SessionEnd never ran.
        # Hide it; a new session in this pane overwrites the file. (Entries from before this
        # field existed have no process and stay visible.)
        [[ -n "$proc" && -z "${alive[$proc]-}" ]] && continue
        IFS=$'\t' read -r target title <<<"$(tmux display -p -t "$id" $'#S:#I.#P\t#{pane_title}')"
        # Claude Code sets the pane title to a session summary, e.g. "✳ Fix login bug".
        [[ "$title" =~ ^[^[:alnum:][:space:]]+[[:space:]]+(.*)$ ]] && title="${BASH_REMATCH[1]}"
        [[ -z "$title" || "$title" == "$(hostname)" ]] && title="${cwd##*/}"
        case "$status" in
            waiting) rank=0 icon="?" color=31 ;;
            done) rank=1 icon="●" color=32 ;;
            running) rank=2 icon="◐" color=33 ;;
            *) rank=3 icon="○" color=90 ;;
        esac
        printf '%s\t%s\t%s\t\e[%sm%s %-7s\e[0m  %-36.36s  \e[36m%-24.24s\e[0m \e[90m%-14.14s %4s\e[0m\n' \
            "$rank" "$epoch" "$id" "$color" "$icon" "$status" "$title" "$target" "${cwd##*/}" "$(ago "$epoch")"
    done | sort -t$'\t' -k1,1n -k2,2nr | cut -f3-
}

jump() {
    tmux switch-client -t "$1" \; select-window -t "$1" \; select-pane -t "$1"
}

ui() {
    # fzf has no key chords, so "dd" keeps state in the (hidden) prompt: the first
    # d sets it to "d> ", a second d clears the entry, any other key resets it.
    local keys="j,k,g,G,d,r,q,/" header="j/k move · g/G top/bottom · Enter jump · dd clear · r refresh · / filter · q quit"
    local extra=()
    # Optional companion: search all past sessions (github.com/dodokr/tmux-claude-sessions).
    if command -v claude-sessions >/dev/null; then
        keys+=",s" header="${header/ · q quit/ · s search all · q quit}"
        extra=(--bind="s:become(claude-sessions)")
    fi
    local reset="change-prompt(> )"
    local normal="rebind($keys)+hide-input+clear-query+$reset"
    local dd="[[ \$FZF_PROMPT == 'd> ' ]] && echo '$reset+execute-silent($self clear {1})+reload($self list)' || echo 'change-prompt(d> )'"
    "$self" list | fzf --ansi --no-sort --no-input --delimiter=$'\t' --with-nth=2 \
        --layout=reverse --border=rounded --border-label=" Claude sessions " \
        --header="$header" \
        --header-first --info=hidden --pointer="▌" --gutter=" " --prompt="> " \
        --with-shell="bash -c" \
        --bind="j:down+$reset,k:up+$reset,g:first+$reset,G:last+$reset,q:abort" \
        --bind="enter:execute-silent($self jump {1})+abort" \
        --bind="d:transform:$dd" \
        --bind="r:reload($self list)+$reset" \
        --bind="/:show-input+unbind($keys)+$reset" \
        --bind="esc:transform:[[ \$FZF_INPUT_STATE == hidden ]] && echo abort || echo '$normal'" \
        "${extra[@]}"
}

case "$1" in
    hook) hook "$2" ;;
    list) list ;;
    clear) rm -f -- "$state/${2#%}" ;;
    jump) jump "$2" ;;
    "") ui ;;
    *) sed -n '2,9s/^# \{0,1\}//p' "$self" >&2; exit 1 ;;
esac
